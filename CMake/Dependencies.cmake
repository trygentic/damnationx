# Options that control whether to use system dependencies or build them from source,
# and whether to link them statically.
include(functions/dependency_options)

# WebGPU inputs are explicit so native Dawn and Emdawnwebgpu builds remain reproducible.
option(DEVILUTIONX_WEBGPU "Enable the shared WebGPU client" OFF)
set(DEVILUTIONX_WEBGPU_HEADER_REVISION "31e25af254ab572c77054edec4946d2244e184dd" CACHE STRING "Pinned webgpu.h revision")
set(DEVILUTIONX_DAWN_REVISION "31e25af254ab572c77054edec4946d2244e184dd" CACHE STRING "Pinned native Dawn revision")
set(DEVILUTIONX_EMDAWNWEBGPU_REVISION "v20260423.175430" CACHE STRING "Pinned Emdawnwebgpu revision")
set(DEVILUTIONX_WEBGPU_PACKAGE_SOURCE "https://github.com/google/dawn/archive/31e25af254ab572c77054edec4946d2244e184dd.tar.gz" CACHE STRING "Immutable WebGPU package source URL")
set(DEVILUTIONX_WEBGPU_LICENSE "BSD-3-Clause" CACHE STRING "SPDX license identifier for WebGPU package")
set(DEVILUTIONX_DAWN_LINKAGE "static" CACHE STRING "Native Dawn linkage: static or shared")
set_property(CACHE DEVILUTIONX_DAWN_LINKAGE PROPERTY STRINGS static shared)

# Emscripten WebGPU toolchain pins.
# These are deliberately separate from DEVILUTIONX_EMSCRIPTEN_VERSION (3.1.74, CMakeLists.txt):
# that pin freezes the Wasm mod-host ABI, whereas the WebGPU presenter needs an Emscripten
# that can consume Emdawnwebgpu port files (4.0.10+). The port itself is pinned to the
# release package of DEVILUTIONX_EMDAWNWEBGPU_REVISION and verified by SHA256 at configure
# time; Emscripten's builtin `emdawnwebgpu` port floats the Dawn snapshot and is opt-in only.
set(DEVILUTIONX_WEBGPU_EMSCRIPTEN_VERSION "4.0.11" CACHE STRING "Minimum Emscripten version for the WebGPU browser build")
set(DEVILUTIONX_EMDAWNWEBGPU_PORT_SHA256 "3ad7ebe95a4a20764df46c5a63b0ad489782aee26804fff8511d9797c10e732f" CACHE STRING "SHA256 of emdawnwebgpu_pkg-<DEVILUTIONX_EMDAWNWEBGPU_REVISION>.zip")
set(DEVILUTIONX_EMDAWNWEBGPU_PORT_FILE "" CACHE FILEPATH "Local emdawnwebgpu.port.py to use instead of downloading the pinned package (offline builds)")
option(DEVILUTIONX_EMDAWNWEBGPU_BUILTIN_PORT "Use Emscripten's builtin emdawnwebgpu port instead of the pinned package (floats the Dawn snapshot)" OFF)

if(DEVILUTIONX_WEBGPU)
  foreach(_webgpu_pin IN ITEMS DEVILUTIONX_WEBGPU_HEADER_REVISION DEVILUTIONX_DAWN_REVISION DEVILUTIONX_EMDAWNWEBGPU_REVISION DEVILUTIONX_WEBGPU_PACKAGE_SOURCE DEVILUTIONX_WEBGPU_LICENSE DEVILUTIONX_WEBGPU_EMSCRIPTEN_VERSION DEVILUTIONX_EMDAWNWEBGPU_PORT_SHA256)
    if("${${_webgpu_pin}}" STREQUAL "")
      message(FATAL_ERROR "DEVILUTIONX_WEBGPU requires ${_webgpu_pin}; floating inputs are not allowed")
    endif()
  endforeach()
  if(NOT DEVILUTIONX_DAWN_LINKAGE STREQUAL "static" AND NOT DEVILUTIONX_DAWN_LINKAGE STREQUAL "shared")
    message(FATAL_ERROR "DEVILUTIONX_DAWN_LINKAGE must be static or shared")
  endif()
  if(DEVILUTIONX_DAWN_REVISION MATCHES "^(main|master|latest|develop|[vV]?[0-9]+(\\.[0-9]+)*)$")
    message(FATAL_ERROR "DEVILUTIONX_DAWN_REVISION must be an immutable revision")
  endif()
  message(STATUS "WebGPU package: ${DEVILUTIONX_WEBGPU_PACKAGE_SOURCE} (${DEVILUTIONX_WEBGPU_LICENSE})")
  message(STATUS "WebGPU pins: header=${DEVILUTIONX_WEBGPU_HEADER_REVISION}; Dawn=${DEVILUTIONX_DAWN_REVISION}; Emdawnwebgpu=${DEVILUTIONX_EMDAWNWEBGPU_REVISION}; linkage=${DEVILUTIONX_DAWN_LINKAGE}")
  if(EMSCRIPTEN)
    # EMSCRIPTEN_VERSION is set by Emscripten's toolchain file from `emcc --version`.
    if(NOT EMSCRIPTEN_VERSION)
      message(FATAL_ERROR "DEVILUTIONX_WEBGPU: the Emscripten toolchain file did not report EMSCRIPTEN_VERSION; configure through `emcmake cmake`")
    endif()
    if(EMSCRIPTEN_VERSION VERSION_LESS DEVILUTIONX_WEBGPU_EMSCRIPTEN_VERSION)
      if(DEVILUTIONX_EMDAWNWEBGPU_PORT_FILE)
        message(WARNING "DEVILUTIONX_WEBGPU: Emscripten ${EMSCRIPTEN_VERSION} is older than the pinned ${DEVILUTIONX_WEBGPU_EMSCRIPTEN_VERSION}; continuing only because DEVILUTIONX_EMDAWNWEBGPU_PORT_FILE is set. The Emdawnwebgpu port may not build with this release.")
      else()
        message(FATAL_ERROR
          "DEVILUTIONX_WEBGPU needs Emscripten >= ${DEVILUTIONX_WEBGPU_EMSCRIPTEN_VERSION} (found ${EMSCRIPTEN_VERSION}): older releases cannot consume the pinned Emdawnwebgpu port.\n"
          "Install it in a SECOND emsdk clone so the ${DEVILUTIONX_EMSCRIPTEN_VERSION} Wasm mod-host pin stays intact (never `emsdk activate` inside the ${DEVILUTIONX_EMSCRIPTEN_VERSION} clone; that rewrites its .emscripten):\n"
          "  git clone https://github.com/emscripten-core/emsdk.git <dir>/emsdk-${DEVILUTIONX_WEBGPU_EMSCRIPTEN_VERSION}\n"
          "  <dir>/emsdk-${DEVILUTIONX_WEBGPU_EMSCRIPTEN_VERSION}/emsdk install ${DEVILUTIONX_WEBGPU_EMSCRIPTEN_VERSION} && <dir>/emsdk-${DEVILUTIONX_WEBGPU_EMSCRIPTEN_VERSION}/emsdk activate ${DEVILUTIONX_WEBGPU_EMSCRIPTEN_VERSION}\n"
          "  source <dir>/emsdk-${DEVILUTIONX_WEBGPU_EMSCRIPTEN_VERSION}/emsdk_env.sh   # scoped to this shell\n"
          "then configure again in a fresh build directory. See docs/building.md (Emscripten). "
          "To force an older Emscripten anyway, pass -DDEVILUTIONX_EMDAWNWEBGPU_PORT_FILE=<path to emdawnwebgpu_pkg/emdawnwebgpu.port.py>.")
      endif()
    endif()
    message(STATUS "WebGPU Emscripten: ${EMSCRIPTEN_VERSION} (minimum ${DEVILUTIONX_WEBGPU_EMSCRIPTEN_VERSION}); Emdawnwebgpu package SHA256=${DEVILUTIONX_EMDAWNWEBGPU_PORT_SHA256}")
  endif()
endif()
include(functions/emscripten_system_library)

# Opt-in Wasm mod host prerequisites.
if(DEVILUTIONX_ENABLE_WASM_MOD_HOST)
  find_program(DEVILUTIONX_RUSTC rustc REQUIRED)
  find_program(DEVILUTIONX_CARGO cargo REQUIRED)
  set(DEVILUTIONX_WASMI_CRATE "wasmi = \"=${DEVILUTIONX_WASMI_VERSION}\"" CACHE INTERNAL "Pinned mod interpreter dependency (native and browser)")
  execute_process(COMMAND "${DEVILUTIONX_RUSTC}" --version OUTPUT_VARIABLE DEVILUTIONX_RUSTC_VERSION OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT DEVILUTIONX_RUSTC_VERSION MATCHES "rustc ${DEVILUTIONX_RUST_VERSION}([.]|$)")
    message(FATAL_ERROR "Expected rustc ${DEVILUTIONX_RUST_VERSION}, got '${DEVILUTIONX_RUSTC_VERSION}'")
  endif()
  if(EMSCRIPTEN)
    find_program(DEVILUTIONX_EMCC emcc REQUIRED)
    execute_process(COMMAND "${DEVILUTIONX_EMCC}" --version OUTPUT_VARIABLE DEVILUTIONX_EMCC_VERSION ERROR_VARIABLE DEVILUTIONX_EMCC_VERSION OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT DEVILUTIONX_EMCC_VERSION MATCHES "${DEVILUTIONX_EMSCRIPTEN_VERSION}")
      message(FATAL_ERROR "Expected Emscripten ${DEVILUTIONX_EMSCRIPTEN_VERSION}, got '${DEVILUTIONX_EMCC_VERSION}'")
    endif()
  endif()
  message(STATUS "dxmod-core-1 prerequisites: Rust ${DEVILUTIONX_RUST_VERSION}, Emscripten ${DEVILUTIONX_EMSCRIPTEN_VERSION}, wasmi ${DEVILUTIONX_WASMI_VERSION} (native and browser)")
endif()

