execute_process(COMMAND "${C_FIXTURE}" RESULT_VARIABLE c_result OUTPUT_VARIABLE c_bytes)
execute_process(COMMAND "${RUST_FIXTURE}" RESULT_VARIABLE rust_result OUTPUT_VARIABLE rust_bytes)
if(NOT c_result STREQUAL "0" OR NOT rust_result STREQUAL "0")
  message(FATAL_ERROR "Codec checks failed: C=${c_result}, Rust=${rust_result}")
endif()
file(READ "${GOLDEN}" expected)
string(REPLACE "\r\n" "\n" c_bytes "${c_bytes}")
string(REPLACE "\r\n" "\n" rust_bytes "${rust_bytes}")
if(NOT c_bytes STREQUAL expected OR NOT rust_bytes STREQUAL expected)
  message(FATAL_ERROR "C/Rust fixture bytes differ from normative golden")
endif()
