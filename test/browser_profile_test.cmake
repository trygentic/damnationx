# Configure-only regression test: no SDK, network, or host SDL discovery needed.
file(MAKE_DIRECTORY "${TEST_BINARY_DIR}/source/Packaging/emscripten")
foreach(_file index.html file-manager.js)
  file(WRITE "${TEST_BINARY_DIR}/source/Packaging/emscripten/${_file}" "")
endforeach()
file(WRITE "${TEST_BINARY_DIR}/source/CMakeLists.txt" "
cmake_minimum_required(VERSION 3.22)
project(BrowserProfile NONE)
include(\"${PROJECT_SOURCE_DIR}/CMake/platforms/emscripten.cmake\")
if(NOT USE_SDL3)
  message(FATAL_ERROR \"Browser must select SDL3\")
endif()
get_directory_property(definitions COMPILE_DEFINITIONS)
if(NOT \"DEVILUTIONX_BROWSER_SINGLE_THREADED=1\" IN_LIST definitions)
  message(FATAL_ERROR \"Missing browser compile profile\")
endif()
")
foreach(_case baseline pthread shared sdl2)
  set(_flags "")
  if(_case STREQUAL pthread)
    set(_flags "-pthread")
  elseif(_case STREQUAL shared)
    set(_flags "-sSHARED_MEMORY=1")
  elseif(_case STREQUAL sdl2)
    set(_flags "-sUSE_SDL=2")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}"
    -S "${TEST_BINARY_DIR}/source" -B "${TEST_BINARY_DIR}/${_case}"
    "-DCMAKE_CXX_FLAGS=${_flags}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(_case STREQUAL baseline)
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "Baseline failed: ${_out}${_err}")
    endif()
  elseif(_result EQUAL 0 OR NOT "${_out}${_err}" MATCHES "Single-threaded SDL3 browser profile conflicts")
    message(FATAL_ERROR "${_case} was not rejected by the profile: ${_out}${_err}")
  endif()
endforeach()
